#!/bin/bash

# Pre-commit hook for staged secrets and Rust checks.

set -e

echo "Running pre-commit checks..."

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "Install Gitleaks 8.30.1 or newer and add it to PATH before committing." >&2
    exit 1
fi

echo "Scanning staged changes for secrets..."
gitleaks git --staged --verbose --redact --no-banner .

# Check formatting
echo "Checking code formatting..."
cargo fmt -- --check || {
    echo "❌ Code formatting check failed!"
    echo "Run 'make fmt-fix' or 'cargo fmt' to fix formatting issues."
    exit 1
}

# Run clippy
echo "Running clippy..."
cargo clippy -- -D warnings || {
    echo "❌ Clippy check failed!"
    exit 1
}

# Build
echo "Building project..."
cargo build --verbose || {
    echo "❌ Build failed!"
    exit 1
}

# Run tests
echo "Running tests..."
cargo test --verbose || {
    echo "❌ Tests failed!"
    exit 1
}

echo "✅ All pre-commit checks passed!"
exit 0

